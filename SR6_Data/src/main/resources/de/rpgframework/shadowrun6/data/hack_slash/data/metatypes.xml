	<metatype id="pilot-ai" ai="true" human="false">
   	<modifications>
      	<allowmod type="MAGIC_RESO" ref="magician" neg="true"/>
      	<allowmod type="MAGIC_RESO" ref="mysticadept" neg="true"/>
      	<allowmod type="MAGIC_RESO" ref="adept" neg="true"/>
      	<allowmod type="MAGIC_RESO" ref="aspectedmagician" neg="true"/>
      	<allowmod type="MAGIC_RESO" ref="minor_awakened" neg="true"/>
            <valmod type="ITEM_ATTRIBUTE" ref="DATA_PROCESSING" value="7" set="MAX" when="CREATION"/>
            <valmod type="ITEM_ATTRIBUTE" ref="ATTACK"          value="7" set="MAX" when="CREATION"/>
            <valmod type="ATTRIBUTE"     ref="LOGIC"            value="5" set="MAX" when="CREATION"/>
