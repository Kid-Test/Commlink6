            <valmod type="ATTRIBUTE"     ref="CHARISMA"         value="5" set="MAX" when="CREATION"/>
            <valmod type="QUALITY"       ref="pilot_origins"    value="1"/>
            <itemmod type="QUALITY"      ref="sensor_upgrade"   />
        </modifications>
    </metatype>

